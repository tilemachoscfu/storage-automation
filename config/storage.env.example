# Copy to storage.env, replace CHANGE_ME values, and keep the result private.
HOST_STORAGE_PATH=CHANGE_ME
CONTAINER_STORAGE_PATH=/storage
VOLUME_ID=CHANGE_ME
OWNER_UID=1000
OWNER_GID=1000
DIRECTORY_MODE=2770

# Gluetun / AirVPN values belong in a private Compose .env file.
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=CHANGE_ME
WIREGUARD_ADDRESSES=CHANGE_ME
SERVER_COUNTRIES=CHANGE_ME

